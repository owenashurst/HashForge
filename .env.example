# Copy this file to .env and fill it in. The .env file is ignored by git; never commit real passwords.

# --- Storage ----------------------------------------------------------------
# Folder that holds everything the stack stores: the blockchain, Redis snapshots and the database.
DATA_DIR=./data

# --- Bitcoin node -----------------------------------------------------------
# mainnet, testnet4, signet or regtest
NETWORK=mainnet
# Disk budget for blocks in MiB (550 is the minimum). Set to 0 to run a full, unpruned node.
PRUNE_MB=550
BITCOIN_VERSION=32.1
RPC_USER=hashforge
RPC_PASSWORD=change-me
# Memory (MiB) the node may use for its coin database. Raising it (e.g. 2048) makes the first sync much faster.
DB_CACHE_MB=450
# Host port for Bitcoin peer-to-peer connections.
P2P_PORT=8333
# Block space reserved for the pool's coinbase. 100000 covers 500 payout outputs.
BLOCK_RESERVED_WEIGHT=100000

# --- Database ---------------------------------------------------------------
POSTGRES_USER=hashforge
POSTGRES_PASSWORD=change-me-too

# --- Pools ------------------------------------------------------------------
# Receives the pool fee and nothing else. Must belong to the chosen NETWORK.
# It may be left empty only if every enabled pool's *_FEE_PERCENT is 0; otherwise the pool will not start.
POOL_FEE_ADDRESS=
COINBASE_TAG=/HashForge/
# Between blocks, how often (in seconds) miners are sent a new job that includes transactions which arrived
# since the last one. Miners keep their current work in flight; only a new block makes them drop it.
TEMPLATE_REFRESH_SECONDS=30
# How often (in seconds) the network figures shown in the UI and API (difficulty, network hashrate, height,
# sync progress, last block) are re-read from the node. New blocks reach miners immediately regardless.
NETWORK_STATS_REFRESH_SECONDS=30

SOLO_ENABLED=true
SOLO_PORT=3333
SOLO_FEE_PERCENT=1

PPLNS_ENABLED=true
PPLNS_PORT=3334
PPLNS_FEE_PERCENT=1
PPLNS_WINDOW_MULTIPLIER=2

PROP_ENABLED=true
PROP_PORT=3335
PROP_FEE_PERCENT=1

# Finder bonus: whoever finds the block gets BONUS_FINDER_SATOSHIS (1 BTC by default); the rest is split like PROP.
BONUS_ENABLED=false
BONUS_PORT=3336
BONUS_FEE_PERCENT=1
BONUS_FINDER_SATOSHIS=100000000

# Most miners paid in one block. Lower this if your miners' firmware struggles with large coinbases.
MAX_COINBASE_OUTPUTS=500
# A ceiling on the above for every pool, including pools added from the admin page (0 = none). Set it to 10
# if you point the pool at a node you cannot start with BLOCK_RESERVED_WEIGHT, such as a shared or managed one.
MAX_COINBASE_OUTPUTS_CEILING=0
# Ports published for pools you start later from the admin page.
ADMIN_POOL_PORT_RANGE=3337-3341
STRATUM_INITIAL_DIFFICULTY=1024
# The lowest difficulty vardiff will assign. Only very small miners, or regtest testing, need it lower.
STRATUM_MIN_DIFFICULTY=0.001

# --- Branding ---------------------------------------------------------------
# Run the pool under your own name. The accent colour is #RRGGBB (quote it: # starts a comment otherwise).
BRAND_NAME=HashForge
BRAND_TAGLINE=Open-source Bitcoin mining pool
BRAND_ACCENT_COLOR="#f7931a"
# An https:// image URL, or empty to show the name's initial as the logo.
BRAND_LOGO_URL=

# --- Web UI -----------------------------------------------------------------
WEB_PORT=8080
# The host name or IP miners use to reach this machine; shown on the "Connect" page.
STRATUM_HOST=your-pool-host
# Networks allowed to open the admin page (CIDR). See the README note about Docker Desktop.
ADMIN_NETWORK_1=192.168.0.0/24
ADMIN_NETWORK_2=192.168.1.0/24
# IP of a reverse proxy in front of the web UI, if any, so the allow-list sees visitors' real addresses.
TRUSTED_PROXY=
# Only when a reverse proxy serves the web UI under a sub-path (https://example.com/pool/ rather than
# https://pool.example.com/): the request header in which the proxy names that path, e.g. X-Forwarded-Prefix.
PATH_BASE_HEADER=
ADMIN_NETWORK_3=127.0.0.0/8
# Optional password for the admin page, asked for on top of the network check. Set one when the pool is
# behind a proxy or on Docker Desktop, where the network check cannot tell visitors apart. Use HTTPS in
# front of the pool if the password will cross a network you do not trust.
ADMIN_PASSWORD=

# --- Discord notifications (optional) ---------------------------------------
# Paste a Discord webhook URL to get a message when something notable happens. Leave empty to disable.
DISCORD_WEBHOOK_URL=
DISCORD_NOTIFY_BLOCK_FOUND=true
# A pool's best share so far. At most one message per pool per cooldown period.
DISCORD_NOTIFY_BEST_SHARE=true
DISCORD_BEST_SHARE_COOLDOWN_SECONDS=60