@inherits LayoutComponentBase
@inject IOptions<BrandingOptions> Branding

<header class="site-header">
    <div class="header-inner">
        <a class="brand" href="">
            @if (Branding.Value.EffectiveLogoUrl.Length == 0)
            {
                <span class="brand-mark" aria-hidden="true">@Branding.Value.Initial</span>
            }
            else
            {
                <img class="brand-mark" src="@Branding.Value.EffectiveLogoUrl" alt="" />
            }
            <span class="brand-name">@Branding.Value.Name</span>
        </a>
        <NavMenu />
        <div class="header-status">
            <NodeStatus />
        </div>
    </div>
</header>

<main class="content">
    @Body
</main>

<SiteFooter />

<div id="blazor-error-ui" data-nosnippet>
    Something went wrong.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
