@page "/admin"
@rendermode InteractiveServer
@inherits RefreshingComponent
@inject INetworkStatsStore NetworkStats
@inject IPoolOverview Overview
@inject IConnectedMiners Miners
@inject IPoolProvisioner Provisioner

<BrandTitle Page="Admin" />

<div class="page-head">
    <h1>Admin</h1>
    <p>Node status, pool management and connected miners. This page is only reachable from the allowed networks.</p>
</div>

<SectionCard Icon="IconKind.Storage" Title="Bitcoin node" Aside="@(_network is null ? null : $"checked {Display.Age(_network.UpdatedAt, Now)}")">
    @if (_network is null)
    {
        <p class="notice">The Bitcoin node has not answered yet.</p>
    }
    else
    {
        <section class="tiles">
            <StatTile Icon="IconKind.Sync" Label="Sync status" Value="@(_network.IsSynced ? "Synced" : "Synchronising")" Hint="@Display.Percent(_network.SyncPercent)" />
            <StatTile Icon="IconKind.Block" Label="Blocks" Value="@Display.Count(_network.Height)" Hint="@($"of {Display.Count(_network.Headers)} headers")" />
            <StatTile Icon="IconKind.Chain" Label="Chain" Value="@_network.Chain" />
            <StatTile Icon="IconKind.Storage" Label="Storage" Value="@Display.Bytes(_network.SizeOnDisk)" Hint="@(_network.Pruned ? "pruned node" : "full node")" />
        </section>
    }
</SectionCard>

<section class="tiles">
    <StatTile Icon="IconKind.Accepted" Label="Accepted shares" Value="@Display.Count(_totals.Accepted)" Hint="all pools" />
    <StatTile Icon="IconKind.Rejected" Label="Reject rate" Value="@Display.RejectRate(_totals.Accepted, _totals.Rejected)" Hint="@($"{StatsText.RejectedCount(_totals.Rejected)}, all pools")" />
    <StatTile Icon="IconKind.Connections" Label="Connections" Value="@Display.Count(_sessions.Count)" Hint="@($"{_addresses.Count} IP addresses")" />
</section>

<SectionCard Icon="IconKind.Port" Title="Pools" Aside="@PoolCounts()" Flush="true"
             Footnote="A stopped pool stays stopped, restarts included, until you start it here. Pools created on this page can be deleted once stopped; a pool set in the configuration is removed by turning it off there.">
    @if (_pools.Count == 0 && _stopped.Count == 0)
    {
        <p class="empty">There are no pools. Create one below.</p>
    }
    else
    {
        <div class="table-scroll">
            <table>
                <thead>
                    <tr><th>Pool</th><th>Payout</th><th class="num">Port</th><th class="num">Miners</th><th class="num">Accepted</th><th class="num">Rejected</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var pool in _pools)
                    {
                        <tr>
                            <td><a href="pool/@pool.Name">@pool.Name</a></td>
                            <td><SchemeBadge Scheme="pool.Scheme" /></td>
                            <td class="num">@pool.Port</td>
                            <td class="num">@pool.MinerCount</td>
                            <td class="num">@Display.Count(pool.Stats.Accepted)</td>
                            <td class="num">@StatsText.RejectedWithRate(pool.Stats.Accepted, pool.Stats.Rejected)</td>
                            <td class="num"><button type="button" class="danger" @onclick="() => StopAsync(pool.Name)">Stop</button></td>
                        </tr>
                    }
                    @foreach (var pool in _stopped)
                    {
                        <tr class="stopped">
                            <td>@pool.Definition.Name <span class="badge">STOPPED</span></td>
                            <td><SchemeBadge Scheme="pool.Definition.Scheme" /></td>
                            <td class="num">@pool.Definition.Port</td>
                            <td class="num">@Display.None</td>
                            <td class="num">@Display.None</td>
                            <td class="num">@Display.None</td>
                            <td class="num row-actions">
                                <button type="button" class="quiet" @onclick="() => StartAsync(pool.Definition.Name)">Start</button>
                                @if (pool.CanBeDeleted)
                                {
                                    <button type="button" class="danger" @onclick="() => DeleteAsync(pool.Definition.Name)">Delete</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</SectionCard>

<SectionCard Icon="IconKind.Port" Title="Create a pool"
             Footnote="@($"Starts immediately, with no restart. Under Docker, pick a port inside the published range (ADMIN_POOL_PORT_RANGE, from {WebOptions.FirstSparePoolPort} by default).")">
    <EditForm Model="_form" OnValidSubmit="AddAsync" FormName="add-pool" class="stack-form">
        <label>Name <InputText @bind-Value="_form.Name" placeholder="pplns-2" /></label>
        <label>
            Payout
            <InputSelect @bind-Value="_form.Scheme">
                @foreach (var scheme in Enum.GetValues<PayoutScheme>())
                {
                    <option value="@scheme">@scheme.Label()</option>
                }
            </InputSelect>
        </label>
        <label>Port <InputNumber @bind-Value="_form.Port" /></label>
        <label>Fee % <InputNumber @bind-Value="_form.FeePercent" /></label>
        @if (_form.Scheme == PayoutScheme.FinderBonus)
        {
            <label>Finder bonus (BTC) <InputNumber id="finder-bonus" @bind-Value="_form.FinderBonusBitcoin" step="0.01" min="0" /></label>
        }
        <label>Fee address <InputText @bind-Value="_form.FeeAddress" placeholder="@(_form.FeePercent > 0 ? "bc1q…" : "not needed at 0% fee")" /></label>
        <button type="submit">Create pool</button>
    </EditForm>
    @if (_message is not null)
    {
        <p class="@(_succeeded ? "success" : "notice error") form-status" role="status">@_message</p>
    }
</SectionCard>

<SectionCard Icon="IconKind.Connections" Title="Connected miners" Aside="@($"{_sessions.Count} connections")" Flush="true">
    @if (_sessions.Count == 0)
    {
        <p class="empty">No miners are connected.</p>
    }
    else
    {
        <div class="table-scroll">
            <table>
                <thead>
                    <tr>
                        <th>IP address</th><th>Pool</th><th>Address</th><th>Workers</th>
                        <th class="num">Difficulty</th><th class="num">Accepted</th><th class="num">Rejected</th><th>Connected</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var session in _sessions)
                    {
                        <tr>
                            <td class="mono">@session.RemoteAddress</td>
                            <td>@session.PoolName</td>
                            <td class="mono" title="@session.MinerAddress">@(session.MinerAddress is null ? "not authorised" : Display.Shorten(session.MinerAddress))</td>
                            <td>@string.Join(", ", session.Workers)</td>
                            <td class="num">@Display.Difficulty(session.Difficulty)</td>
                            <td class="num">@Display.Count(session.Accepted)</td>
                            <td class="num">@StatsText.RejectedWithRate(session.Accepted, session.Rejected)</td>
                            <td>@Display.Age(session.ConnectedAt, Now)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</SectionCard>

@if (_addresses.Count > 0)
{
    <SectionCard Icon="IconKind.Network" Title="IP addresses" Aside="@($"{_addresses.Count} distinct")">
        <ul class="ip-list">
            @foreach (var address in _addresses)
            {
                <li><code>@address.Address</code> <span class="muted">× @address.Connections</span></li>
            }
        </ul>
    </SectionCard>
}

@code {
    private readonly PoolForm _form = new() { Port = WebOptions.FirstSparePoolPort };
    private IReadOnlyList<PoolSnapshot> _pools = [];
    private IReadOnlyList<ManagedPool> _stopped = [];
    private IReadOnlyList<SessionInfo> _sessions = [];
    private IReadOnlyList<ConnectedAddress> _addresses = [];
    private ShareTotals _totals = new(0, 0);
    private NetworkStats? _network;
    private string? _message;
    private bool _succeeded;

    protected override Task LoadAsync()
    {
        _network = NetworkStats.Current;
        _pools = Overview.GetPools();
        _stopped = [.. Provisioner.GetPools().Where(pool => !pool.IsRunning)];
        _totals = Overview.GetTotals();
        _sessions = Miners.GetSessions();
        _addresses = Miners.GetAddresses();
        return Task.CompletedTask;
    }

    private async Task AddAsync()
    {
        var result = await Provisioner.AddAsync(_form.ToDefinition(), Cancellation);
        _succeeded = result.Succeeded;
        _message = result.Succeeded ? $"Pool “{_form.Name}” is now listening on port {_form.Port}." : result.Error;
        await LoadAsync();
    }

    private string PoolCounts() =>
        _stopped.Count == 0 ? $"{_pools.Count} running" : $"{_pools.Count} running, {_stopped.Count} stopped";

    private Task StopAsync(string name) =>
        ApplyAsync(Provisioner.StopAsync(name, Cancellation), $"Pool “{name}” was stopped. It stays stopped until you start it again.");

    private Task StartAsync(string name) =>
        ApplyAsync(Provisioner.StartAsync(name, Cancellation), $"Pool “{name}” is running again.");

    private Task DeleteAsync(string name) =>
        ApplyAsync(Provisioner.DeleteAsync(name, Cancellation), $"Pool “{name}” was deleted.");

    private async Task ApplyAsync(Task<ProvisionResult> change, string done)
    {
        var result = await change;
        _succeeded = result.Succeeded;
        _message = result.Succeeded ? done : result.Error;
        await LoadAsync();
    }
}
