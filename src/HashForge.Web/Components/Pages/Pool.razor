@page "/pool/{Name}"
@rendermode InteractiveServer
@inherits RefreshingComponent
@inject IPoolOverview Overview
@inject IStatisticsReader Statistics
@inject IPoolHistoryRepository History
@inject IBlockRepository BlockRepository
@inject NavigationManager Navigation
@inject IOptions<WebOptions> Options

<BrandTitle Page="@Name" />

@if (_pool is null)
{
    <div class="page-head">
        <a class="back-link" href="">← All pools</a>
        <h1>Pool not found</h1>
        <p>There is no running pool called “@Name”.</p>
    </div>
}
else
{
    <div class="page-head">
        <a class="back-link" href="">← All pools</a>
        <h1>@_pool.Name <SchemeBadge Scheme="_pool.Scheme" /></h1>
        <p>Stratum port @_pool.Port · @Display.Count(_pool.MinerCount) miners · @_pool.WorkerCount workers</p>
    </div>

    <StatsTiles Stats="_pool.Stats" Now="Now" />

    <SectionCard Icon="IconKind.Hashrate" Title="Hashrate" Aside="@($"last {Options.Value.ChartHours} hours")">
        <HashrateChart Samples="_history" />
    </SectionCard>

    <SectionCard Icon="IconKind.Miners" Title="Find a miner">
        <form class="inline-form" @onsubmit="OpenMiner">
            <label for="miner-address">Bitcoin address</label>
            <input id="miner-address" @bind="_address" placeholder="bc1q…" maxlength="@AddressFormat.MaxLength" autocomplete="off" spellcheck="false" />
            <button type="submit">Show miner</button>
        </form>
        @if (_searchError is not null)
        {
            <p class="notice error form-status" role="alert">@_searchError</p>
        }
    </SectionCard>

    <SectionCard Icon="IconKind.Miners" Title="Miners" Aside="@($"{_miners.Count} with shares")" Flush="true"
                 Footnote="Addresses are shortened so they cannot be collected from this page. Enter your own above to see your statistics.">
        @if (_miners.Count == 0)
        {
            <p class="empty">No miners have submitted shares yet.</p>
        }
        else
        {
            <div class="table-scroll">
                <table>
                    <thead>
                        <tr>
                            <th>Address</th>
                            <th class="num">Workers</th>
                            <th class="num">Hashrate</th>
                            <th class="num">Accepted</th>
                            <th class="num">Rejected</th>
                            <th class="num">Effort</th>
                            <th class="num">Best share</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var miner in _miners)
                        {
                            <tr>
                                <td class="mono">@Display.Shorten(miner.Address)</td>
                                <td class="num">@miner.Workers.Count</td>
                                <td class="num">@Display.Hashrate(miner.Stats.Hashrate)</td>
                                <td class="num">@Display.Count(miner.Stats.Accepted)</td>
                                <td class="num" title="@StatsText.RejectedCount(miner.Stats.Rejected)">@Display.RejectRate(miner.Stats.Accepted, miner.Stats.Rejected)</td>
                                <td class="num"><EffortMeter Percent="miner.Stats.EffortPercent" /></td>
                                <td class="num">@StatsText.BestDifficulty(miner.Stats.BestShare)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </SectionCard>

    <SectionCard Icon="IconKind.Block" Title="Blocks found" Aside="@($"latest {Options.Value.RecentBlockCount}")" Flush="true">
        <BlockTable Blocks="_blocks" Now="Now" ShowPool="false" />
    </SectionCard>
}

@code {
    private PoolSnapshot? _pool;
    private IReadOnlyList<MinerSnapshot> _miners = [];
    private IReadOnlyList<PoolHistorySample> _history = [];
    private IReadOnlyList<FoundBlock> _blocks = [];
    private string _address = string.Empty;
    private string? _searchError;

    [Parameter]
    public string Name { get; set; } = string.Empty;

    protected override async Task LoadAsync()
    {
        _pool = Overview.FindPool(Name);
        if (_pool is null)
        {
            return;
        }

        _miners = Statistics.GetMiners(_pool.Name);
        _history = await History.GetSinceAsync(_pool.Name, Now.AddHours(-Options.Value.ChartHours), Cancellation);
        _blocks = await BlockRepository.GetRecentForPoolAsync(_pool.Name, Options.Value.RecentBlockCount, Cancellation);
    }

    private void OpenMiner()
    {
        var address = (_address ?? string.Empty).Trim();
        if (address.Length == 0)
        {
            _searchError = null;
            return;
        }

        // Only text shaped like an address is ever put into a URL or looked up.
        if (!AddressFormat.IsPlausible(address))
        {
            _searchError = "That does not look like a Bitcoin address. Addresses contain only letters and digits.";
            return;
        }

        _searchError = null;
        Navigation.NavigateTo($"pool/{Uri.EscapeDataString(Name)}/miner/{Uri.EscapeDataString(address)}");
    }
}
